// App.xcconfig — production target overrides.

#include "Base.xcconfig"

// Alternate app icons compiled from App/App/AvatarIcons.xcassets.
#include "AvatarIcons.xcconfig"

APP_GROUP_ID = group.$(HELLUM_BUNDLE_ID)
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSOCIATED_DOMAIN =
BUNDLE_DISPLAY_NAME = Hellum
BUNDLE_URL_SCHEME = hellum
PRODUCT_BUNDLE_IDENTIFIER = $(HELLUM_BUNDLE_ID)

// Exact portal profile name; must equal release-ios.yaml's `profile_name`.
PROVISIONING_PROFILE_SPECIFIER_Manual = Hellum iOS Distribution
